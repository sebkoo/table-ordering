{
  "name": "table-ordering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "verify": "node --disable-warning=ExperimentalWarning tools/verify.ts",
    "conventions": "node --disable-warning=ExperimentalWarning tools/check-conventions.ts",
    "check-push": "node --disable-warning=ExperimentalWarning tools/check-push.ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && tsc --noEmit -p apps/guest/tsconfig.json && tsc --noEmit -p apps/staff/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "dev": "pnpm --filter @table-ordering/api dev",
    "dev:guest": "pnpm --filter @table-ordering/guest dev",
    "dev:staff": "pnpm --filter @table-ordering/staff dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
